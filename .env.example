# ─────────────────────────────────────────────────────────────────────────────
# Lendmax CRM — environment
# Copy to .env and fill in. NEVER commit a real .env.
# Every value below is read once at boot by src/config/env.ts, which refuses to
# start if something required is missing or obviously wrong. A CRM that boots
# with a broken integration and discovers it at 2am is worse than one that
# refuses to boot at 6pm.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3400
# Where the CRM is mounted. The app is designed to live under a path prefix so
# it can sit behind the existing lendmax.ca site without owning the domain.
BASE_PATH=/crm
PUBLIC_URL=https://lendmax.ca/crm
# IANA zone. All scheduling, quiet hours and business-day maths resolve through
# this; browser-local time is never trusted for anything that gets sent.
BROKERAGE_TIMEZONE=America/Toronto

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres@127.0.0.1:5433/lendmax_brokerage_crm
# Set to 1 only against a managed provider that requires it.
DATABASE_SSL=0
DATABASE_POOL_MAX=10

# ── Sessions / auth ─────────────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Absolute cap regardless of activity.
SESSION_ABSOLUTE_TTL_HOURS=168

# ── Object storage (documents) ──────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Signed download links are short-lived. Documents are never publicly readable.
DOCUMENT_URL_TTL_SECONDS=300
S3_BUCKET=
S3_REGION=ca-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── apply.lendmax.ca (the application portal) ───────────────────────────────
# The portal owns the application. The CRM mirrors it and never edits it.
PORTAL_BASE_URL=https://apply.lendmax.ca
PORTAL_INTERNAL_API_KEY=
# Shared secret the portal signs its mirror pushes with.
PORTAL_WEBHOOK_SECRET=

# ── Scarlett Mortgage ───────────────────────────────────────────────────────
SCARLETT_BASE_URL=
SCARLETT_API_KEY=
SCARLETT_PARTNER_ID=
# Refuse to push to a live Scarlett from a non-production box.
SCARLETT_MODE=sandbox

# ── VoIP.ms (SMS / MMS) ─────────────────────────────────────────────────────
VOIPMS_API_USER=
VOIPMS_API_PASSWORD=
VOIPMS_DEFAULT_DID=
# Verifies inbound webhook callbacks.
VOIPMS_WEBHOOK_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# smtp | resend | postmark | console
EMAIL_DRIVER=console
EMAIL_FROM="Lendmax <noreply@lendmax.ca>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
POSTMARK_API_KEY=

# ── Google Calendar ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lendmax.ca/crm/api/integrations/google/callback

# ── AI assist (optional; assistive only, never authoritative) ───────────────
AI_ENABLED=0
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
